# terminal-arkmos — o que o terminal usa, pelo Homebrew do Bazzite.
#
# A mesma lista do Arkmos, onde essas ferramentas vêm de RPM ou do build. O
# fzf fica de fora: o Bazzite já o traz em /usr/bin.

# Prompt e plugins do zsh
brew "starship"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"
brew "zsh-completions"

# Substitutos modernos usados pelos aliases e pelo fzf
brew "eza"
brew "bat"
brew "fd"
brew "ripgrep"
brew "zoxide"

# Editor, versões de linguagem e git
brew "neovim"
brew "mise"
brew "lazygit"
